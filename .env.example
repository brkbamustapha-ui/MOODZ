# ------------------------------------------------------------------
# MOODZ : variables d'environnement (copiez ce fichier en .env.local)
# ------------------------------------------------------------------

# Base de données PostgreSQL (Supabase, Neon...). Obligatoire sur Vercel.
# Supabase : Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Laissez vide en local : une base embarquée (PGlite) est créée dans .data/
DATABASE_URL=

# Compte gérant créé au premier démarrage (obligatoire en production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Clé de signature des sessions (32 caractères minimum, aléatoire).
# Exemple pour en générer une : openssl rand -base64 48
# Si absente, une clé aléatoire est générée et conservée dans la base.
AUTH_SECRET=

# Adresse publique du site (image de partage, sitemap, données structurées), ex. https://moodz-oran.com
# Facultatif sur Vercel : le domaine de production est détecté automatiquement.
NEXT_PUBLIC_SITE_URL=

# Options avancées
# DATABASE_SSL=disable        # connexion PostgreSQL locale sans TLS
# DATABASE_POOL_MAX=5         # connexions simultanées par instance
# PGLITE_DIR=.data/pglite     # dossier de la base embarquée (auto-hébergement)
